{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paint",
  "mainBinaryName": "paint",
  "version": "1.0.0",
  "identifier": "org.paintrs.paint",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:wasm",
    "beforeDevCommand": "npm run build:wasm"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paint",
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Paint",
    "longDescription": "Simple raster image editor in the spirit of Microsoft Paint, written in Rust with a WebAssembly engine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "name": "PNG",
        "role": "Editor"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "name": "JPEG",
        "role": "Editor"
      },
      {
        "ext": [
          "bmp"
        ],
        "mimeType": "image/bmp",
        "name": "BMP",
        "role": "Editor"
      },
      {
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "name": "GIF",
        "role": "Editor"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "mimeType": "image/tiff",
        "name": "TIFF",
        "role": "Editor"
      },
      {
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "name": "WEBP",
        "role": "Editor"
      },
      {
        "ext": [
          "ico"
        ],
        "mimeType": "image/x-icon",
        "name": "ICO",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "desktopTemplate": "paint.desktop"
      },
      "rpm": {
        "desktopTemplate": "paint.desktop"
      }
    }
  }
}
