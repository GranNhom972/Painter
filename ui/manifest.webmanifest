{
  "name": "Paint",
  "short_name": "Paint",
  "description": "Éditeur d'images (moteur Rust compilé en WebAssembly)",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e8ecf2",
  "theme_color": "#f9f9fb",
  "icons": [
    { "src": "icons/paint-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icons/paint-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/paint.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "image/*": [".png", ".jpg", ".jpeg", ".bmp", ".gif", ".tif", ".tiff", ".webp", ".ico"] }
    }
  ]
}
